runtime/
__pycache__/
*.py[cod]
*.pyd

# User data, managed mods, backups, and local logs
mods/
backups/
*.log
settings.json

# Credentials and local environment files
.env
.env.*
*.key
*.pem
*.pfx
*.p12

# IDE and OS files
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db
