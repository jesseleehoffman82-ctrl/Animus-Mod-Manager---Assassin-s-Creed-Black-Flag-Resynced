<Button x:Name="HDFinishColor" Content="Choose color…" HorizontalAlignment="Left" Margin="0,0,0,8"/>

<Button x:Name="HDExportFinish" Content="Save finish PNG" HorizontalAlignment="Left" Margin="0,0,0,8"/>

<CheckBox x:Name="HDShared" Content="Apply to matching surfaces" Foreground="#C4D5DB" Margin="0,4,0,8"/>

<Button x:Name="HDRestore" Content="Reset this finish" HorizontalAlignment="Left" Margin="0,0,0,8"/>

              </StackPanel>

              <Border Grid.Row="2" Background="#081822" BorderBrush="#173B49" BorderThickness="1" CornerRadius="4" Padding="4">

                <Grid>

                  <Image x:Name="TexturePreview" Stretch="Uniform" Cursor="Hand" ToolTip="Click to enlarge the selected game texture"/>

                  <TextBlock x:Name="TexturePreviewEmpty" Text="No source PNG" Foreground="#6F8791" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>

                </Grid>

              </Border>

            </Grid>

          </Border>

          <Button x:Name="ChoosePng" Grid.Row="5" Content="EXPORT PNG" Height="34" Margin="0"

                  Background="#1B5575" BorderBrush="#3A7898" BorderThickness="1"

                  Foreground="#F0F7FA" FontWeight="SemiBold"

                  ToolTip="Export the currently selected extracted game texture without modifying it"/>

        </Grid>

      </Border>

    </Grid>



    <Grid Grid.Row="2">

      <TextBlock x:Name="Footer" Text="The source .forge archive is never written to. Selectable zones follow the Jackdaw's texture groups." Foreground="#91A8B3" VerticalAlignment="Bottom"/>

      <TextBlock Text="Model extracted locally from your installed copy" Foreground="#91A8B3" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

    </Grid>

  </Grid>

</Window>
