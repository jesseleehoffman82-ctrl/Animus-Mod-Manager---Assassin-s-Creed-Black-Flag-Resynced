

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"

        Title="Jackdaw Workshop - Drydock Studio" Width="1660" Height="990"

        MinWidth="1360" MinHeight="800" WindowStartupLocation="CenterScreen"

        Background="#02080D" Foreground="#EDF6F7" FontFamily="Segoe UI Variable Text">

  <Window.Resources>

    <SolidColorBrush x:Key="AppBackground" Color="#02080D"/>

    <SolidColorBrush x:Key="PanelBackground" Color="#06131B"/>

    <SolidColorBrush x:Key="PanelRaised" Color="#091B25"/>

    <SolidColorBrush x:Key="PanelBorder" Color="#173440"/>

    <SolidColorBrush x:Key="CyanAccent" Color="#22D3EE"/>

    <SolidColorBrush x:Key="GoldAccent" Color="#D6A64A"/>

    <SolidColorBrush x:Key="PrimaryText" Color="#EDF6F7"/>

    <SolidColorBrush x:Key="SecondaryText" Color="#8FA7B1"/>

    <DropShadowEffect x:Key="PanelShadow" Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.42"/>

    <Style TargetType="Button">

      <Setter Property="Background" Value="#0B2735"/><Setter Property="Foreground" Value="#E8F4F6"/>

      <Setter Property="BorderBrush" Value="#244A5B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,4"/>

      <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>

      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>

      <Setter Property="Template">

        <Setter.Value>

          <ControlTemplate TargetType="Button">

            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">

              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

            </Border>

            <ControlTemplate.Triggers>

              <Trigger Property="IsMouseOver" Value="True">

                <Setter TargetName="Bd" Property="Background" Value="#104054"/>

                <Setter TargetName="Bd" Property="BorderBrush" Value="#2D7188"/>

              </Trigger>

              <Trigger Property="IsPressed" Value="True">

                <Setter TargetName="Bd" Property="Background" Value="#061923"/>

              </Trigger>

              <Trigger Property="IsEnabled" Value="False">

                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>

              </Trigger>

            </ControlTemplate.Triggers>

          </ControlTemplate>

        </Setter.Value>

      </Setter>

    </Style>

    <Style x:Key="ApplyMainSegmentStyle" TargetType="Button">

      <Setter Property="Background" Value="#1F7A3B"/>

      <Setter Property="Foreground" Value="#F3FFF6"/>

      <Setter Property="BorderThickness" Value="0"/>

      <Setter Property="Padding" Value="6,4"/>

      <Setter Property="Margin" Value="0"/>

      <Setter Property="Cursor" Value="Hand"/>

      <Setter Property="FontSize" Value="10"/>

      <Setter Property="Template">

        <Setter.Value>

          <ControlTemplate TargetType="Button">

            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6,0,0,6" Padding="{TemplateBinding Padding}">

              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

            </Border>

            <ControlTemplate.Triggers>

              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#288D48"/></Trigger>

              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#175F30"/></Trigger>

              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.55"/></Trigger>

            </ControlTemplate.Triggers>

          </ControlTemplate>

        </Setter.Value>

      </Setter>

    </Style>

    <Style x:Key="ApplyArrowSegmentStyle" TargetType="Button">

      <Setter Property="Background" Value="#1A6D36"/>

      <Setter Property="Foreground" Value="#F3FFF6"/>

      <Setter Property="BorderThickness" Value="0"/>

      <Setter Property="Padding" Value="0"/>

      <Setter Property="Margin" Value="0"/>

      <Setter Property="Cursor" Value="Hand"/>

      <Setter Property="Template">

        <Setter.Value>

          <ControlTemplate TargetType="Button">

            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0,6,6,0" BorderBrush="#145A2B" BorderThickness="1,0,0,0">

              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

            </Border>

            <ControlTemplate.Triggers>

              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#288D48"/></Trigger>

              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#145A2B"/></Trigger>

              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.55"/></Trigger>

            </ControlTemplate.Triggers>

          </ControlTemplate>

        </Setter.Value>

      </Setter>

    </Style>

    <Style x:Key="RevertDesignButtonStyle" TargetType="Button">

      <Setter Property="Background" Value="#132B3A"/>

      <Setter Property="Foreground" Value="#EADFC7"/>

      <Setter Property="BorderThickness" Value="0"/>

      <Setter Property="Padding" Value="6,4"/>

      <Setter Property="Margin" Value="0"/>

      <Setter Property="Cursor" Value="Hand"/>

      <Setter Property="FontSize" Value="10"/>

      <Setter Property="Template">

        <Setter.Value>

          <ControlTemplate TargetType="Button">

            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#29495A" BorderThickness="1" Padding="{TemplateBinding Padding}">

              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

            </Border>

            <ControlTemplate.Triggers>

              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#183B4E"/></Trigger>

              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#0B1C27"/></Trigger>

              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.55"/></Trigger>

            </ControlTemplate.Triggers>

          </ControlTemplate>

        </Setter.Value>

      </Setter>

    </Style>

    <Style x:Key="ViewModeButtonStyle" TargetType="Button">

      <Setter Property="Background" Value="#091821"/>

      <Setter Property="Foreground" Value="#B8C9D0"/>

      <Setter Property="BorderBrush" Value="#1C3946"/>

      <Setter Property="BorderThickness" Value="1"/>

      <Setter Property="Padding" Value="12,5"/>

      <Setter Property="Margin" Value="0,0,7,0"/>

      <Setter Property="Cursor" Value="Hand"/>

      <Setter Property="FontSize" Value="11"/>

      <Setter Property="FontWeight" Value="SemiBold"/>

      <Setter Property="Template">

        <Setter.Value>

          <ControlTemplate TargetType="Button">

            <Border x:Name="ViewBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">

              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

            </Border>

            <ControlTemplate.Triggers>

              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ViewBd" Property="Background" Value="#163E52"/><Setter TargetName="ViewBd" Property="BorderBrush" Value="#3A6980"/></Trigger>

              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ViewBd" Property="Background" Value="#081B27"/></Trigger>

              <Trigger Property="Tag" Value="Active"><Setter TargetName="ViewBd" Property="Background" Value="#073746"/><Setter TargetName="ViewBd" Property="BorderBrush" Value="#22D3EE"/><Setter Property="Foreground" Value="#E9FDFF"/></Trigger>

              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ViewBd" Property="Opacity" Value="0.42"/></Trigger>

            </ControlTemplate.Triggers>

          </ControlTemplate>

        </Setter.Value>

      </Setter>

    </Style>

    <Style x:Key="CategoryButtonStyle" TargetType="Button">

      <Setter Property="Background" Value="#081A24"/>

      <Setter Property="Foreground" Value="#D8E7EA"/>

      <Setter Property="BorderBrush" Value="#163A49"/>

      <Setter Property="BorderThickness" Value="1"/>

      <Setter Property="Padding" Value="11,0"/>

      <Setter Property="Cursor" Value="Hand"/>

      <Setter Property="FontWeight" Value="SemiBold"/>

      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

      <Setter Property="Template">

        <Setter.Value>

          <ControlTemplate TargetType="Button">

            <Border x:Name="CategoryBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">

              <Grid>

                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <TextBlock Text="&#x203A;" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18" Foreground="{TemplateBinding Foreground}"/>

              </Grid>

            </Border>

            <ControlTemplate.Triggers>

              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CategoryBd" Property="Background" Value="#0B3342"/><Setter TargetName="CategoryBd" Property="BorderBrush" Value="#22D3EE"/><Setter Property="Foreground" Value="#F2FEFF"/></Trigger>

              <Trigger Property="IsPressed" Value="True"><Setter TargetName="CategoryBd" Property="Background" Value="#0B2735"/></Trigger>

            </ControlTemplate.Triggers>

          </ControlTemplate>

        </Setter.Value>

      </Setter>

    </Style>

    <Style x:Key="JackdawProgressStyle" TargetType="ProgressBar">

      <Setter Property="Background" Value="#183543"/>

      <Setter Property="Foreground" Value="#3FAE63"/>

      <Setter Property="BorderThickness" Value="0"/>

      <Setter Property="Template">

        <Setter.Value>

          <ControlTemplate TargetType="ProgressBar">

            <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">

              <Grid x:Name="PART_Track" ClipToBounds="True">

                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>

              </Grid>

            </Border>

          </ControlTemplate>

        </Setter.Value>

      </Setter>

    </Style>

    <Style TargetType="ComboBox">

      <Setter Property="Background" Value="#0A1A25"/><Setter Property="Foreground" Value="#EADFC7"/>

      <Setter Property="BorderBrush" Value="#224152"/>

      <Setter Property="BorderThickness" Value="1"/>

      <Setter Property="Padding" Value="8,5"/>

      <Setter Property="Margin" Value="0"/>

      <Setter Property="Template">

        <Setter.Value>

          <ControlTemplate TargetType="ComboBox">

            <Grid>

              <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>

              <ToggleButton x:Name="ToggleButton" Focusable="False" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">

                <Grid>

                  <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="28"/>

                  </Grid.ColumnDefinitions>

                  <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                  <Path Grid.Column="1" Width="8" Height="5" Fill="#EADFC7" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 8 0 L 4 5 Z"/>

                </Grid>

              </ToggleButton>

              <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade">

                <Border Background="#07141D" BorderBrush="#224152" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0">

                  <ScrollViewer Margin="4" MaxHeight="260">

                    <ItemsPresenter/>

                  </ScrollViewer>

                </Border>

              </Popup>

            </Grid>

          </ControlTemplate>

        </Setter.Value>

      </Setter>

    </Style>

    <Style TargetType="ComboBoxItem">

      <Setter Property="Foreground" Value="#EADFC7"/>

      <Setter Property="Background" Value="Transparent"/>

      <Setter Property="Padding" Value="8,6"/>

      <Setter Property="Template">

        <Setter.Value>

          <ControlTemplate TargetType="ComboBoxItem">

            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">

              <ContentPresenter/>

            </Border>

            <ControlTemplate.Triggers>

              <Trigger Property="IsHighlighted" Value="True">

                <Setter TargetName="Bd" Property="Background" Value="#163A4C"/>

              </Trigger>

              <Trigger Property="IsSelected" Value="True">

                <Setter TargetName="Bd" Property="Background" Value="#18465D"/>

              </Trigger>

            </ControlTemplate.Triggers>

          </ControlTemplate>

        </Setter.Value>

      </Setter>

    </Style>

    <Style TargetType="TextBox">

      <Setter Property="Background" Value="#07131A"/><Setter Property="Foreground" Value="#EADFC7"/>

      <Setter Property="BorderBrush" Value="#223F4F"/><Setter Property="BorderThickness" Value="1"/>

      <Setter Property="Padding" Value="10,5"/>

      <Setter Property="Template">

        <Setter.Value>

          <ControlTemplate TargetType="TextBox">

            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">

              <ScrollViewer x:Name="PART_ContentHost" Margin="0" />

            </Border>

            <ControlTemplate.Triggers>

              <Trigger Property="IsKeyboardFocused" Value="True">

                <Setter TargetName="Bd" Property="BorderBrush" Value="#D6A64A"/>

              </Trigger>

            </ControlTemplate.Triggers>

          </ControlTemplate>

        </Setter.Value>

      </Setter>

    </Style>

    <Style TargetType="ListBox">

      <Setter Property="Background" Value="#0D2230"/><Setter Property="Foreground" Value="#EADFC7"/>

      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4"/>

    </Style>

    <Style TargetType="ListView">

      <Setter Property="Background" Value="#0D2230"/><Setter Property="Foreground" Value="#EADFC7"/>

      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4"/>

      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>

      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>

      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>

      <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>

      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>

      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>

    </Style>

    <Style TargetType="ListViewItem">

      <Setter Property="Margin" Value="0,2,0,2"/>

      <Setter Property="Padding" Value="4"/>

      <Setter Property="Template">

        <Setter.Value>

          <ControlTemplate TargetType="ListViewItem">

            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">

              <ContentPresenter />

            </Border>

            <ControlTemplate.Triggers>

              <Trigger Property="IsMouseOver" Value="True">

                <Setter TargetName="Bd" Property="Background" Value="#15384A"/>

              </Trigger>

              <Trigger Property="IsSelected" Value="True">

                <Setter TargetName="Bd" Property="Background" Value="#16475E"/>

              </Trigger>

            </ControlTemplate.Triggers>

          </ControlTemplate>

        </Setter.Value>

      </Setter>

    </Style>

    <Style TargetType="ScrollBar">

      <Setter Property="Width" Value="11"/>

      <Setter Property="Background" Value="#061118"/>

      <Setter Property="BorderThickness" Value="0"/>

      <Setter Property="Template">

        <Setter.Value>

          <ControlTemplate TargetType="ScrollBar">

            <Grid Background="Transparent" Width="{TemplateBinding Width}">

              <Track x:Name="PART_Track" IsDirectionReversed="True">

                <Track.DecreaseRepeatButton>

                  <RepeatButton Command="ScrollBar.LineUpCommand" Style="{x:Null}" Background="Transparent" BorderThickness="0" Focusable="False"/>

                </Track.DecreaseRepeatButton>

                <Track.Thumb>

                  <Thumb>

                    <Thumb.Template>

                      <ControlTemplate TargetType="Thumb">

                        <Border Background="#223948" CornerRadius="5" Margin="2"/>

                      </ControlTemplate>

                    </Thumb.Template>

                  </Thumb>

                </Track.Thumb>

                <Track.IncreaseRepeatButton>

                  <RepeatButton Command="ScrollBar.LineDownCommand" Style="{x:Null}" Background="Transparent" BorderThickness="0" Focusable="False"/>

                </Track.IncreaseRepeatButton>

              </Track>

            </Grid>

          </ControlTemplate>

        </Setter.Value>

      </Setter>

    </Style>

    <DataTemplate x:Key="ZoneRowTemplate">

      <Grid Margin="1,1">

        <Grid.Style>

          <Style TargetType="Grid">

            <Setter Property="Margin" Value="12,1,2,1"/>

            <Setter Property="Opacity" Value="0.96"/>

            <Style.Triggers>

              <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">

                <Setter Property="Margin" Value="1,2,2,2"/>

                <Setter Property="Opacity" Value="1"/>

              </DataTrigger>

            </Style.Triggers>

          </Style>

        </Grid.Style>

        <Grid.ColumnDefinitions>

          <ColumnDefinition Width="30"/>

          <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <Border Width="24" Height="24" CornerRadius="3" Background="#08141C" BorderBrush="#244757" BorderThickness="1" VerticalAlignment="Center">

          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>

        </Border>

        <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">

          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>

          <TextBlock Text="{Binding Summary}" Foreground="#91A8B3" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>

        </StackPanel>

      </Grid>

    </DataTemplate>

    <Style TargetType="CheckBox">

      <Setter Property="Foreground" Value="#EADFC7"/><Setter Property="Margin" Value="0,4,0,4"/>

    </Style>

  </Window.Resources>

  <Grid Margin="16,14,16,10">

    <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>

    <Grid Grid.Row="0">

      <Grid.RowDefinitions>

        <RowDefinition Height="58"/>

        <RowDefinition Height="38"/>

        <RowDefinition Height="0"/>

      </Grid.RowDefinitions>

      <Grid.ColumnDefinitions>

        <ColumnDefinition Width="*"/>

        <ColumnDefinition Width="360"/>

      </Grid.ColumnDefinitions>

      <Grid>

        <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Width="48" Height="48" CornerRadius="10" BorderBrush="#2A7183" BorderThickness="1" Background="#081C26" VerticalAlignment="Top" Effect="{StaticResource PanelShadow}">

          <Grid>

            <Path Data="M23,5 L38,38 L23,31 L8,38 Z" Stroke="#DDF9FC" StrokeThickness="2" Fill="#061118"/>

            <Ellipse Width="11" Height="11" Fill="#22D3EE" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"/>

          </Grid>

        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Top">

          <TextBlock Text="J A C K D A W   W O R K S H O P" FontSize="21" FontWeight="SemiBold"/>

          <TextBlock Text="D R Y D O C K   S T U D I O" Foreground="#7FA3B0" FontSize="9" FontWeight="SemiBold" Margin="1,3,0,0"/>

        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5,0,0">
          <Button x:Name="DesignNew" Content="New" Width="58" Height="32"/>
          <Button x:Name="DesignOpen" Content="Open" Width="58" Height="32"/>
          <Button x:Name="DesignSave" Content="Save" Width="58" Height="32" Background="#14506A"/>
          <Button x:Name="DesignFolder" Content="Folder" Width="64" Height="32" ToolTip="Open this design's files"/>
        </StackPanel>

      </Grid>

      <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#07151D" BorderBrush="#1A3C48" BorderThickness="1" CornerRadius="9" Padding="14,8" MinWidth="330" Effect="{StaticResource PanelShadow}">

        <StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

            <Ellipse Width="9" Height="9" Fill="#28E27A" Margin="0,0,8,0">

              <Ellipse.Effect><DropShadowEffect Color="#22C55E" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>

            </Ellipse>

            <TextBlock Text="GAME DETECTED" Foreground="#5DEB91" FontWeight="SemiBold"/>

          </StackPanel>

          <TextBlock x:Name="GameStatus" Text="Looking for Black Flag Resynced..." Foreground="#91A8B3" HorizontalAlignment="Right" Margin="0,3,0,0"/>

        </StackPanel>

      </Border>

      <Grid Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center">

        <Grid.ColumnDefinitions>

          <ColumnDefinition Width="Auto"/>

          <ColumnDefinition Width="16"/>

          <ColumnDefinition Width="270"/>

          <ColumnDefinition Width="*"/>

          <ColumnDefinition Width="450"/>

        </Grid.ColumnDefinitions>

        <Grid Grid.Column="2" Width="270" VerticalAlignment="Center" HorizontalAlignment="Left">

          <Grid.ColumnDefinitions>

            <ColumnDefinition Width="Auto"/>

            <ColumnDefinition Width="9"/>

            <ColumnDefinition Width="*"/>

          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="SEARCH" FontSize="10" FontWeight="SemiBold" Foreground="#91A8B3" VerticalAlignment="Center"/>

          <Grid Grid.Column="2" Height="28">

            <TextBox x:Name="PngSearch" Background="#08141C" Foreground="#EADFC7" BorderBrush="#244557" BorderThickness="1" Padding="8,3" Height="28" Text=""/>

            <TextBlock x:Name="PngSearchHint" Text="Search textures..." IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#6F8791" FontSize="11"/>

          </Grid>

        </Grid>

        <TextBlock x:Name="WorkflowStatus" Grid.Column="3" Margin="12,0" Foreground="#8FD8FF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

          <Button x:Name="ViewShip" Style="{StaticResource ViewModeButtonStyle}" Content="Ship" Width="72" Height="30" Tag="Active"/>

          <Button x:Name="ViewCannons" Style="{StaticResource ViewModeButtonStyle}" Content="Cannons" Width="84" Height="30"/>

          <Button x:Name="ViewMortar" Style="{StaticResource ViewModeButtonStyle}" Content="Mortar" Width="74" Height="30"/>

          <Button x:Name="ViewSwivel" Style="{StaticResource ViewModeButtonStyle}" Content="Swivel" Width="74" Height="30"/>

          <Button x:Name="ViewCabin" Style="{StaticResource ViewModeButtonStyle}" Content="Cabin" Width="74" Height="30" Margin="0"/>

        </StackPanel>

      </Grid>

    </Grid>



    <Grid Grid.Row="1">

      <Grid.ColumnDefinitions>

        <ColumnDefinition Width="252"/>

        <ColumnDefinition Width="12"/>

        <ColumnDefinition Width="*"/>

        <ColumnDefinition Width="12"/>

        <ColumnDefinition Width="252"/>

      </Grid.ColumnDefinitions>



      <Border Grid.Column="0" Background="#07151D" BorderBrush="#173743" BorderThickness="1" CornerRadius="9" Padding="10" Effect="{StaticResource PanelShadow}">

        <Grid>

          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="82"/><RowDefinition Height="76"/></Grid.RowDefinitions>

          <Border Grid.Row="0" Background="#061119" BorderBrush="#173743" BorderThickness="1" CornerRadius="7" Padding="6" Margin="0,0,0,8">

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

              <StackPanel>

                <TextBlock Text="DESIGN LIBRARIES" Foreground="#93AEB8" FontWeight="SemiBold" FontSize="10" Margin="6,3,0,6"/>

                <Button x:Name="CatSails" Style="{StaticResource CategoryButtonStyle}" Height="29" Margin="0,0,0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="&#x25B2;" Foreground="#80DCEC" Width="24"/><TextBlock Text="Sails"/></StackPanel></Button>

                <Button x:Name="CatHulls" Style="{StaticResource CategoryButtonStyle}" Height="29" Margin="0,0,0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="&#x25B0;" Foreground="#80DCEC" Width="24"/><TextBlock Text="Hull Themes"/></StackPanel></Button>

                <Button x:Name="CatFigureheads" Style="{StaticResource CategoryButtonStyle}" Height="29" Margin="0,0,0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="&#x2693;" Foreground="#80DCEC" Width="24"/><TextBlock Text="Figureheads"/></StackPanel></Button>

                <Button x:Name="CatCannons" Style="{StaticResource CategoryButtonStyle}" Height="29" Margin="0,0,0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="&#x2725;" Foreground="#80DCEC" Width="24"/><TextBlock Text="Cannons"/></StackPanel></Button>

                <Button x:Name="CatMortars" Style="{StaticResource CategoryButtonStyle}" Height="29" Margin="0,0,0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="&#x25C9;" Foreground="#80DCEC" Width="24"/><TextBlock Text="Mortars"/></StackPanel></Button>

                <Button x:Name="CatFlags" Style="{StaticResource CategoryButtonStyle}" Height="29" Margin="0,0,0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="&#x2691;" Foreground="#80DCEC" Width="24"/><TextBlock Text="Flags"/></StackPanel></Button>

                <Button x:Name="CatWheels" Style="{StaticResource CategoryButtonStyle}" Height="29" Margin="0,0,0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="&#x263C;" Foreground="#80DCEC" Width="24"/><TextBlock Text="Wheels"/></StackPanel></Button>

                <Button x:Name="CatCabin" Style="{StaticResource CategoryButtonStyle}" Height="29" Margin="0,0,0,7"><StackPanel Orientation="Horizontal"><TextBlock Text="&#x2302;" Foreground="#80DCEC" Width="24"/><TextBlock Text="Cabin"/></StackPanel></Button>

                <Border Height="1" Background="#244554" Margin="5,0,5,7"/>

                <TextBlock Text="SHIP MATERIAL REGIONS" Foreground="#D6A64A" FontWeight="SemiBold" FontSize="10" Margin="6,0,0,6"/>

                <Button x:Name="CatSailRegions" Style="{StaticResource CategoryButtonStyle}" Height="29" Margin="0,0,0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="&#x25B3;" Foreground="#D6A64A" Width="24"/><TextBlock Text="Sail Panels"/></StackPanel></Button>

